# Copy to .env (same folder as manage.py) and fill in. .env is never uploaded to GitHub.
# The SAME code runs on the laptop and on the server; only this file differs.

# ── Django ───────────────────────────────────────────────
# Laptop: DEBUG=True.  Server: DEBUG=False and a long random SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True
SECRET_KEY=
SITE_DOMAIN=patreoaix.com
# EXTRA_ALLOWED_HOSTS=yourname.pythonanywhere.com
# SECURE_SSL_REDIRECT=True          # server only; set False if https is not set up yet
# WEBSOCKETS_ENABLED=False          # automatic: off on PythonAnywhere, on elsewhere

# ── Market data ──────────────────────────────────────────
TWELVEDATA_API_KEY=
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
DERIV_APP_ID=
# numeric app ID for Deriv's public market data (default 1089, Deriv's shared test app)
DERIV_WS_APP_ID=1089

# ── Email (Gmail app password) ───────────────────────────
EMAIL_HOST_USER=dikkymccria@gmail.com
EMAIL_HOST_PASSWORD=

# ── Payments ─────────────────────────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=True
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
# MPESA_CALLBACK_URL defaults to https://SITE_DOMAIN/account-operations/funding/payment-methods/deposit/mpesa-callback/

# ── Telegram channel for AI signals ──────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@yourchannel
TELEGRAM_MIN_GRADE=A
# your channel's invite link: shown on the landing page ("Free signals on Telegram")
TELEGRAM_INVITE_URL=https://t.me/+yourInviteCode
# after every scan: post the list of strong setups (only when it changed, or again after N minutes; 0 = every scan)
TELEGRAM_SCAN_POSTS=True
TELEGRAM_SCAN_REPEAT_MINUTES=60
# daily plan: morning brief, market pulse when quiet, news alerts, daily + weekly results (times: Nairobi)
TELEGRAM_SCHEDULE=True
TELEGRAM_BRIEF_HOUR=8
TELEGRAM_RECAP_HOUR=22
TELEGRAM_WEEKLY_DAY=6
TELEGRAM_PULSE_HOURS=3
TELEGRAM_NEWS_ALERTS=True
# Market Overview style updates when a market changes to WAIT / GET READY / ENTRY CONFIRMED
TELEGRAM_COACH_UPDATES=True
TELEGRAM_COACH_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,BTCUSD,USOIL
TELEGRAM_COACH_MINUTES=60
TELEGRAM_COACH_DAILY=12

# ── TikTok (signal posters as photo posts; steps in store/tiktok.py) ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MIN_GRADE=A
TIKTOK_DAILY_LIMIT=10
TIKTOK_POST_RESULTS=True

# ── SMS / brokers (optional) ─────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
BINANCE_API_KEY=
BINANCE_API_SECRET=
