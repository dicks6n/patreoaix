# Copy to .env (same folder as manage.py) and fill in. .env is never uploaded to GitHub.
# The SAME code runs on the laptop and on the server; only this file differs.

# ── Django ───────────────────────────────────────────────
# Laptop: DEBUG=True.  Server: DEBUG=False and a long random SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True
SECRET_KEY=
SITE_DOMAIN=patreoaix.com
# EXTRA_ALLOWED_HOSTS=yourname.pythonanywhere.com
# SECURE_SSL_REDIRECT=True          # server only; set False if https is not set up yet
# WEBSOCKETS_ENABLED=False          # automatic: off on PythonAnywhere, on elsewhere

# ── Market data ──────────────────────────────────────────
TWELVEDATA_API_KEY=
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
DERIV_APP_ID=

# ── Email (Gmail app password) ───────────────────────────
EMAIL_HOST_USER=dikkymccria@gmail.com
EMAIL_HOST_PASSWORD=

# ── Payments ─────────────────────────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=True
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
# MPESA_CALLBACK_URL defaults to https://SITE_DOMAIN/account-operations/funding/payment-methods/deposit/mpesa-callback/

# ── SMS / brokers (optional) ─────────────────────────────
